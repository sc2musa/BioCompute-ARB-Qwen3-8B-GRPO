# Copy to configs/server.env (git-ignored) and fill in values for your machine.
# Root directory on persistent storage; runs and logs go below it.
INTERVIEW_ROOT=/path/to/persistent/interview
# Existing Python env with vllm/openai/numpy/scipy. Leave empty to let scripts/setup_env.sh
# create $INTERVIEW_ROOT/envs/arb from requirements-server.txt.
PYTHON_ENV=
# Existing model directory. Leave empty to download MODEL_ID into $INTERVIEW_ROOT/models.
MODEL_DIR=
# Optional: HTTP proxy and pip mirror if the machine has no direct internet access.
HTTP_PROXY_URL=
PIP_INDEX_URL=https://pypi.org/simple
MODEL_ID=Qwen/Qwen3-8B
SERVED_MODEL_NAME=qwen3-8b
VLLM_PORT=8000
# Unprivileged user that runs agent commands and submissions
SANDBOX_USER=agent
# Path to the ROLL checkout used for RL; training/run_rl.sh applies training/roll_patches/ to it
ROLL_DIR=
